# ML Service Configuration
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Model Configuration
MODEL_NAME=densenet121_medical_screening
MODEL_VERSION=1.0.0
MODEL_WEIGHTS_PATH=models/densenet121_chest_xray.h5

# Medical Task Categories
# Classes: NORMAL, PNEUMONIA_MILD, PNEUMONIA_SEVERE, TUBERCULOSIS_SUSPECT, CARDIOMEGALY, EFFUSION
NUM_CLASSES=6

# Confidence Thresholds
CRITICAL_CONFIDENCE_THRESHOLD=0.75
MILD_CONFIDENCE_THRESHOLD=0.45
